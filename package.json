{
  "name": "shopify-store-analyser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "bash -c 'set -a && source .env.local && set +a && prisma db push'",
    "db:migrate": "bash -c 'set -a && source .env.local && set +a && prisma migrate dev'",
    "db:studio": "bash -c 'set -a && source .env.local && set +a && prisma studio'",
    "db:generate": "bash -c 'set -a && source .env.local && set +a && prisma generate'"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.20.0",
    "next": "16.2.7",
    "openai": "^6.43.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3"
  }
}
