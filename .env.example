# Your store's .myshopify.com domain (without https://)
SHOPIFY_STORE_DOMAIN=

# Admin API access token — obtained by installing the app (see /api/auth/callback)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Dev Dashboard app credentials — needed for the one-time OAuth flow
# Find these in Dev Dashboard → your app → Settings → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

GROQ_API_KEY=

# Local development (non-Docker)
DATABASE_URL=
DIRECT_URL=
NEXTAUTH_URL=

AUTH_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Docker: the db service uses postgres://postgres:postgres@db:5432/shopify_analyser
# These are set automatically in docker-compose.yml — no need to set them in .env.local when using Docker.